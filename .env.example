# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# Multi-Model Configuration
# =============================================================================
# Agent9 supports using different OpenAI models for different task types.
# Set these to override the defaults. If not set, optimal defaults are used.
#
# Default model mappings:
#   SQL Generation:    gpt-4o-mini  (fast, structured output)
#   NLP Parsing:       gpt-4o-mini  (fast, extraction)
#   Reasoning:         o1-mini      (complex analysis)
#   Solution Finding:  o1-mini      (multi-perspective debate)
#   Briefing:          gpt-4o       (quality writing)
#   General:           gpt-4o       (balanced)
#
# Override all tasks with a single model:
# OPENAI_MODEL=gpt-4o
#
# Override specific task types:
# OPENAI_MODEL_SQL=gpt-4o-mini
# OPENAI_MODEL_NLP=gpt-4o-mini
# OPENAI_MODEL_REASONING=o1-mini
# OPENAI_MODEL_SOLUTION=o1-mini
# OPENAI_MODEL_BRIEFING=gpt-4o

# =============================================================================
# Database Registry Backend Configuration
# =============================================================================
# Agent9 supports using a SQL database (Postgres, DuckDB) as a backend for registries.
# Set these to enable database-backed registries.
#
# Backend Selection (yaml|database):
# BUSINESS_GLOSSARY_BACKEND=yaml
# PRINCIPAL_PROFILE_BACKEND=yaml
# KPI_REGISTRY_BACKEND=yaml
# BUSINESS_PROCESS_BACKEND=yaml
# DATA_PRODUCT_BACKEND=yaml
#
# Database Connection (Standard DSN):
# DATABASE_URL=postgresql://user:password@localhost:5432/agent9
# OR
# DATABASE_URL=duckdb://data/agent9.duckdb
#
# Supabase Connection (Legacy/Compatibility):
# SUPABASE_DB_URL=postgresql://postgres:password@db.supabase.co:5432/postgres
#
# Note: Legacy REST API configuration (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY)
# is no longer used for registry persistence. Use DATABASE_URL instead.

# =============================================================================
# Deep Analysis / Solution Finder Feature Flags (local dev; all default false in code)
# =============================================================================
# Phase 15 Stage D/E — SF causal grounding + critic pass + theory moderator.
# SF_ENABLE_CAUSAL_GROUNDING=false
# SF_ENABLE_CRITIC_PASS=false
# SF_ENABLE_THEORY_MODERATOR=false
# SF_CAUSAL_MAX_HOPS=2
# SF_STAGE1_ALLOW_FRAME_CHALLENGE=false
#
# Phase 19 — DA mandatory problem-framing gate (see docs/architecture/problem_framing_design.md).
# Required =true for decision-studio-ui/tests/e2e/live-framing-gate*.spec.ts — those specs
# check GET /healthz -> features.da_enable_framing_gate and fail fast if this isn't set.
# DA_ENABLE_FRAMING_GATE=false


